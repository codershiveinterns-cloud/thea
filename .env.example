# --- Database (Supabase Postgres) ---
# Pooled connection (pgbouncer, port 6543) for the app; direct connection (port 5432) for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Public site ---
# Used for canonical URLs, sitemap, OG images, JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://thea.global"

# --- AI generation (phase 3) ---
# Provider: anthropic | gemini | groq (defaults to whichever key below is set). Keys are never logged.
AI_PROVIDER="anthropic"
# Model id for the chosen provider (defaults: claude-opus-5 / gemini-3.6-flash / llama-3.3-70b-versatile)
AI_MODEL=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
# Optional fallback: when the primary provider still returns 429 after retries, the post (and its quality
# check) is generated with Groq instead. Unset = no fallback, the post fails as before.
GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
# Optional: cron expression for `npm run scheduler` (default 09:00 local daily)
# SCHEDULER_CRON="0 9 * * *"

# --- Admin login (HTTP Basic Auth on /admin and /api/admin) ---
# Unset in development = admin open on localhost. Unset in production = admin returns 503.
ADMIN_USER=""
ADMIN_PASSWORD=""

# --- Alerts (Resend) — email when a pipeline run fails or creates no post ---
RESEND_API_KEY=""
ALERT_EMAIL=""
# Sender: a verified Resend domain, or onboarding@resend.dev on the free tier (delivers only to your Resend account email)
ALERT_FROM="Thea <onboarding@resend.dev>"

# --- Go-live ---
# Required: /api/cron/generate refuses every call without it. Vercel sends it as a Bearer token.
CRON_SECRET=""
# IndexNow key; the same value is served from public/<key>.txt
INDEXNOW_KEY=""
