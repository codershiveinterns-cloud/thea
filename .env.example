# --- Database (local dev: SQLite; later: Postgres/Supabase connection string) ---
DATABASE_URL="file:./dev.db"

# --- Public site ---
# Used for canonical URLs, sitemap, OG images, JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- AI generation (phase 3) ---
# Provider: anthropic | gemini (defaults to whichever key below is set). Keys are never logged.
AI_PROVIDER="anthropic"
# Model id for the chosen provider (defaults: claude-opus-5 / gemini-3.6-flash)
AI_MODEL=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
# Optional: cron expression for `npm run scheduler` (default 09:00 local daily)
# SCHEDULER_CRON="0 9 * * *"

# --- Go-live (phase 5) ---
# CRON_SECRET=""
